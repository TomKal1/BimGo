<Project Sdk="Microsoft.NET.Sdk">

	<!-- Main property group -->
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>true</ImplicitUsings>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<PlatformTarget>x64</PlatformTarget>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Prefer32Bit>false</Prefer32Bit>

		<!-- Debug/Release configurations per Revit version -->
		<Configurations>
			Debug R25;Debug R26;Debug R27;
			Release R25;Release R26;Release R27
		</Configurations>

		<!-- Common add-in metadata (version and publisher: src/Directory.Build.props) -->
		<RootNamespace>BimGo</RootNamespace>
		<AssemblyName>BimGo.Revit</AssemblyName>
		<!-- Add-in folder and .addin name (bundle: Contents\<year>\BimGo.addin + BimGo\; Addins\<year>\ only to remove older copies) -->
		<AddinName>BimGo</AddinName>
		<BinRoot>bin</BinRoot>
		<RevitAddinsRoot>$(AppData)\Autodesk\Revit\Addins</RevitAddinsRoot>
	</PropertyGroup>

	<!-- Per-Revit settings and constants -->
	<PropertyGroup Condition="$(Configuration.Contains('25'))">
		<RevitVersion>2025</RevitVersion>
		<!-- Revit 2025.5 (25.5.x) API references .NET 10 System.Runtime -->
		<TargetFramework>net10.0-windows</TargetFramework>
		<DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('26'))">
		<RevitVersion>2026</RevitVersion>
		<!-- Revit 2026.5+ runs on .NET 10; earlier 2026 builds ran on .NET 8 -->
		<TargetFramework>net10.0-windows</TargetFramework>
		<DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('27'))">
		<RevitVersion>2027</RevitVersion>
		<TargetFramework>net10.0-windows</TargetFramework>
		<DefineConstants>$(DefineConstants);REVIT2027</DefineConstants>
	</PropertyGroup>

	<!-- Debug/Release specific flags -->
	<PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
		<DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
		<Optimize>false</Optimize>
		<OutputPath>$(BinRoot)\Debug\$(RevitVersion)\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
		<DefineConstants>$(DefineConstants);TRACE</DefineConstants>
		<Optimize>true</Optimize>
		<OutputPath>$(BinRoot)\Release\$(RevitVersion)\</OutputPath>
	</PropertyGroup>

	<!-- Revit debug launcher -->
	<PropertyGroup>
		<StartAction>Program</StartAction>
		<StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
		<StartArguments>/language ENG</StartArguments>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- Revit specific dll references -->
	<ItemGroup>
		<Reference Include="RevitAPI">
			<HintPath>$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="RevitAPIUI">
			<HintPath>$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Third party package references: none -->

	<!--
		Project references. BimGo.Core holds the shared model, the .bimgo format, edit messages and the live-session
		protocol. The add-in hosts no engine code: walkthroughs run in BimGo.exe (BimGo.App).
	-->
	<ItemGroup>
		<ProjectReference Include="..\BimGo.Core\BimGo.Core.csproj" />
	</ItemGroup>

	<!-- Resource management -->
	<ItemGroup>
		<None Remove="Resources\Icons16\*.png" />
		<None Remove="Resources\Icons32\*.png" />
		<None Remove="Resources\Families\*.rfa" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Icons16\*.png" />
		<EmbeddedResource Include="Resources\Icons32\*.png" />
		<!-- Round Z-B: the comment marker family, written to %LocalAppData%\BimGo\Families when a model needs it -->
		<EmbeddedResource Include="Resources\Families\BimGo_Comment_Marker.rfa" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\Files\Tooltips.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Tooltips.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\Files\Tooltips.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Tooltips.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>


	<!--
		Building process. Every build lays out bin\<config>\<year>\ as the installer needs it: BimGo.addin + BimGo\ (the dll,
		BimGo.Core.dll, no .pdb). Debug builds then deploy it as the installer does, into the per-user Autodesk bundle
		(%AppData%\Autodesk\ApplicationPlugins\BimGo.bundle\Contents\<year>\), and remove any older copy under
		Addins\<year>\ (Revit refuses an add-in id loaded twice). Release builds copy nothing: build\publish.ps1 packages them.
	-->
	<Target Name="CopyToRevitAddins" AfterTargets="Build" Condition="'$(RevitVersion)' != ''">

		<PropertyGroup>
			<BinRoot>$(TargetDir)</BinRoot>
			<BinAddinDir>$(TargetDir)$(AddinName)\</BinAddinDir>
			<BundleDir>$(AppData)\Autodesk\ApplicationPlugins\$(AddinName).bundle</BundleDir>
			<BundleYearDir>$(BundleDir)\Contents\$(RevitVersion)</BundleYearDir>
			<BundleTemplate>$(MSBuildThisFileDirectory)..\..\installer\PackageContents.xml</BundleTemplate>
		</PropertyGroup>

		<!-- bin\<year>\: move the build output into the add-in sub-folder, no .pdb, the .addin beside it -->
		<MakeDir Directories="$(BinAddinDir)" />
		<ItemGroup>
			<BinRootFiles Include="$(BinRoot)*.*" Exclude="$(BinRoot)*.pdb;$(BinRoot)$(AddinName).addin" />
		</ItemGroup>
		<Copy SourceFiles="@(BinRootFiles)" DestinationFiles="@(BinRootFiles->'$(BinAddinDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<Delete Files="@(BinRootFiles)" />
		<ItemGroup>
			<BinPdbFiles Include="$(BinRoot)*.pdb;$(BinAddinDir)**\*.pdb" />
		</ItemGroup>
		<Delete Files="@(BinPdbFiles)" />
		<Copy SourceFiles="$(AddinName).addin" DestinationFiles="$(BinRoot)$(AddinName).addin" SkipUnchangedFiles="true" />

		<!-- Debug only: deploy into the bundle, like the installer -->
		<ItemGroup Condition="$(Configuration.StartsWith('Debug'))">
			<DeployFiles Include="$(BinAddinDir)**\*.*" Exclude="$(BinAddinDir)**\*.pdb" />
		</ItemGroup>
		<Copy Condition="$(Configuration.StartsWith('Debug'))" SourceFiles="@(DeployFiles)"
			  DestinationFiles="@(DeployFiles->'$(BundleYearDir)\$(AddinName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<Copy Condition="$(Configuration.StartsWith('Debug'))" SourceFiles="$(AddinName).addin" DestinationFiles="$(BundleYearDir)\$(AddinName).addin" SkipUnchangedFiles="true" />
		<WriteLinesToFile Condition="$(Configuration.StartsWith('Debug')) And Exists('$(BundleTemplate)')" File="$(BundleDir)\PackageContents.xml"
						  Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(BundleTemplate)').Replace('@VERSION@','$(BimGoVersion)'))))" Overwrite="true" WriteOnlyWhenDifferent="true" />

		<!-- Debug only: an older copy under Addins\<year>\ would load the add-in twice -->
		<Delete Condition="$(Configuration.StartsWith('Debug'))" Files="$(RevitAddinsRoot)\$(RevitVersion)\$(AddinName).addin" ContinueOnError="true" />
		<RemoveDir Condition="$(Configuration.StartsWith('Debug')) And Exists('$(RevitAddinsRoot)\$(RevitVersion)\$(AddinName)')"
				   Directories="$(RevitAddinsRoot)\$(RevitVersion)\$(AddinName)" ContinueOnError="true" />
	</Target>

</Project>
