    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LightingEngineAssembly>$(MSBuildThisFileDirectory)..\..\src\Lighting.Engine\bin\Release\netstandard2.0\Lighting.Engine.dll</LightingEngineAssembly>
    <LightingEngineNotice>$(MSBuildThisFileDirectory)..\..\src\Lighting.Engine\UPSTREAM-NOTICE.md</LightingEngineNotice>
